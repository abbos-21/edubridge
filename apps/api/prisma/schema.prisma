generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  editor
  admin
}

enum AuthProvider {
  telegram
  google
}

enum CatalogueStatus {
  draft
  in_review
  published
  hidden
}

enum RevisionStatus {
  draft
  in_review
  rejected
  published
  superseded
}

enum GrantKind {
  national
  other
}

enum ReminderStatus {
  pending
  sent
  cancelled
  failed
}

enum FindingKind {
  changed
  broken
  blocked
  moved
}

enum FindingStatus {
  open
  accepted
  dismissed
}

// ---------------------------------------------------------------- identity

model User {
  id          String    @id @default(uuid()) @db.Uuid
  displayName String?
  lang        String    @default("uz")
  role        Role      @default(student)
  suspendedAi Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  identities    AuthIdentity[]
  sessions      Session[]
  profile       Profile?
  applications  Application[]
  savedItems    SavedItem[]
  customEvents  CustomEvent[]
  budgets       Budget[]
  chatThreads   ChatThread[]
  advisorDocs   AdvisorDoc[]
  interviews    Interview[]
  growthPlan    GrowthPlan?
  reminders     Reminder[]
  settings      UserSettings?
  telegramLink  TelegramLink?
  linkCodes     TelegramLinkCode[]
  calendarFeed  CalendarFeed?
  aiUsage       AiUsage[]
}

model AuthIdentity {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @db.Uuid
  provider         AuthProvider
  providerUserId   String
  telegramUsername String?
  createdAt        DateTime     @default(now())
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  userAgent String?
  ipHash    String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ------------------------------------------------- private student data
// jsonb shapes mirror the frontend types so localStorage -> server is a straight copy.

model Profile {
  userId    String   @id @db.Uuid
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  opportunityRef String
  data      Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /** id the record had in the guest's browser; makes import-local idempotent */
  localId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localId])
  @@index([userId])
}

model SavedItem {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  kind   String
  ref    String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, ref])
}

model CustomEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  /** id the record had in the guest's browser; makes import-local idempotent */
  localId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localId])
  @@index([userId])
}

model Budget {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  /** id the record had in the guest's browser; makes import-local idempotent */
  localId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localId])
  @@index([userId])
}

model ChatThread {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  data      Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /** id the record had in the guest's browser; makes import-local idempotent */
  localId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localId])
  @@index([userId])
}

// Text only: the uploaded file itself is never stored.
model AdvisorDoc {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  kind         String
  title        String
  originalText String
  workingText  String
  analysis     Json?
  history      Json?
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /** id the record had in the guest's browser; makes import-local idempotent */
  localId String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localId])
  @@index([userId])
}

model Interview {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  /** id the record had in the guest's browser; makes import-local idempotent */
  localId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localId])
  @@index([userId])
}

model GrowthPlan {
  userId    String   @id @db.Uuid
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  userId    String   @id @db.Uuid
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reminder {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  kind      String
  ref       String
  dueAt     DateTime
  channel   String         @default("telegram")
  status    ReminderStatus @default(pending)
  sentAt    DateTime?
  createdAt DateTime       @default(now())
  /** delivery attempts so far and when the next one may run (backoff / short lease while sending) */
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, ref, dueAt])
  @@index([status, dueAt])
}

/** One-time code that links a Telegram chat to an account (10 minutes). Only a hash is stored. */
model TelegramLinkCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/** Revocable secret URL for the calendar feed. Only a hash of the token is stored. */
model CalendarFeed {
  userId    String   @id @db.Uuid
  tokenHash String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramLink {
  userId   String   @id @db.Uuid
  chatId   String   @unique
  optIn    Boolean  @default(true)
  linkedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------- catalogue
// Rows hold the PUBLISHED version. Every change goes through CatalogueRevision.

model Country {
  code      String   @id
  position  Int
  data      Json
  updatedAt DateTime @updatedAt

  universities University[]
}

model University {
  id          String          @id
  countryCode String
  position    Int
  tier        String
  name        String
  short       String?
  city        String?
  type        String?
  website     String?
  status      CatalogueStatus @default(published)
  version     Int             @default(1)
  lastChecked String?
  /** everything else of the university record (campus, subjects, languages, ranking, fee, scholarships, ...) */
  data        Json
  updatedAt   DateTime        @updatedAt

  country Country           @relation(fields: [countryCode], references: [code])
  levels  UniversityLevel[]

  @@index([countryCode, position])
}

model UniversityLevel {
  id           String     @id @default(uuid()) @db.Uuid
  universityId String
  level        String
  data         Json
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, level])
}

model Grant {
  id          String          @id
  kind        GrantKind
  name        String
  country     String
  status      CatalogueStatus @default(published)
  version     Int             @default(1)
  position    Int             @default(0)
  checked     String?
  data        Json
  updatedAt   DateTime        @updatedAt
}

model CatalogueRevision {
  id          String          @id @default(uuid()) @db.Uuid
  entityType  String
  entityId    String
  version     Int
  data        Json
  status      RevisionStatus  @default(draft)
  authorId    String?         @db.Uuid
  reviewedBy  String?         @db.Uuid
  reviewedAt  DateTime?
  comment     String?
  createdAt   DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([status])
}

/** Review marks that do not change what students see (replaces the browser-only "reviewed" override). */
model CatalogueMark {
  entityType String
  entityId   String
  reviewedAt DateTime?
  reviewedBy String?   @db.Uuid
  note       String?
  updatedAt  DateTime  @updatedAt

  @@id([entityType, entityId])
}

model CatalogueMeta {
  id        Int      @id
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Source {
  id                String    @id @default(uuid()) @db.Uuid
  url               String
  kind              String
  entityType        String
  entityId          String
  field             String
  lastCheckedAt     DateTime?
  lastStatus        String?
  lastHash          String?
  httpStatus        Int?
  blocksAutomation  Boolean   @default(false)
  /** where the link ended up after redirects, and the readable text of the last good fetch (capped), used for a short diff */
  finalUrl          String?
  lastText          String?

  findings RecheckFinding[]

  @@unique([entityType, entityId, field, url])
  @@index([url])
}

model DemoSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  kind      String
  title     String
  payload   Json
  /** true when it was saved while the AI was in mock mode: shown as a sample, never as a live result */
  mock      Boolean  @default(false)
  lang      String?
  savedAt   DateTime @default(now())
  savedBy   String?  @db.Uuid
}

// ---------------------------------------------------------- operations

model AiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  task         String
  tier         String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsdEst   Decimal  @default(0) @db.Decimal(10, 5)
  status       String
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  diff       Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model RecheckRun {
  id         String    @id @default(uuid()) @db.Uuid
  /** queued (waiting for the worker) | running | done | failed */
  status     String    @default("queued")
  trigger    String    @default("schedule")
  requestedBy String?  @db.Uuid
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  summary    Json?

  findings RecheckFinding[]
}

model RecheckFinding {
  id         String        @id @default(uuid()) @db.Uuid
  runId      String        @db.Uuid
  sourceId   String        @db.Uuid
  kind       FindingKind
  oldHash    String?
  newHash    String?
  diffSnippet String?
  /** when this link was last checked before this run, and what the fetch said now */
  prevCheckedAt DateTime?
  httpStatus Int?
  finalUrl   String?
  note       String?
  status     FindingStatus @default(open)
  reviewedBy String?       @db.Uuid
  reviewedAt DateTime?

  run    RecheckRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  source Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([status])
}
