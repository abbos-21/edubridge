generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  editor
  admin
}

enum AuthProvider {
  telegram
  google
}

enum ReminderStatus {
  pending
  sent
  cancelled
  failed
}

enum FindingKind {
  changed
  broken
  blocked
  moved
}

enum FindingStatus {
  open
  accepted
  dismissed
}

// ---------------------------------------------------------------- identity

model User {
  id          String   @id @default(uuid()) @db.Uuid
  displayName String?
  lang        String   @default("uz")
  role        Role     @default(student)
  suspendedAi Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  identities   AuthIdentity[]
  sessions     Session[]
  stateDocs    StateDoc[]
  reminders    Reminder[]
  telegramLink TelegramLink?
  linkCodes    TelegramLinkCode[]
  calendarFeed CalendarFeed?
  aiUsage      AiUsage[]
}

model AuthIdentity {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @db.Uuid
  provider         AuthProvider
  providerUserId   String
  telegramUsername String?
  createdAt        DateTime     @default(now())
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  userAgent String?
  ipHash    String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ------------------------------------------------- the student's app state
// The web app keeps one state object. The server stores it as five documents (core, profile, plans, writing, ai) plus
// the derived calendar the app computes for reminders. Each has a version for optimistic concurrency.

model StateDoc {
  userId    String   @db.Uuid
  key       String
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

// ----------------------------------------------------------- reminders

model Reminder {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  /// the calendar item it is about (the app's own event id) and the date it is for
  ref           String
  itemDate      String
  title         Json
  dueAt         DateTime
  status        ReminderStatus @default(pending)
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  attempts      Int            @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ref, dueAt])
  @@index([status, dueAt])
}

/// One-time code that links a Telegram chat to an account (10 minutes). Only a hash is stored.
model TelegramLinkCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Revocable secret URL for the calendar feed. Only a hash of the token is stored.
model CalendarFeed {
  userId    String   @id @db.Uuid
  tokenHash String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramLink {
  userId   String   @id @db.Uuid
  chatId   String   @unique
  optIn    Boolean  @default(true)
  linkedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------- catalogue
// The app's reference data (universities, scholarships, programmes). Each dataset is one JSON document that the
// editors change record by record; every change is written to AuditLog and bumps the version.

model CatalogDataset {
  name      String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model CatalogMeta {
  id        Int      @id
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Source {
  id               String    @id @default(uuid()) @db.Uuid
  url              String
  dataset          String
  recordId         String
  field            String
  lastCheckedAt    DateTime?
  lastStatus       String?
  lastHash         String?
  httpStatus       Int?
  blocksAutomation Boolean   @default(false)
  finalUrl         String?
  lastText         String?

  findings RecheckFinding[]

  @@unique([dataset, recordId, field, url])
  @@index([url])
}

model RecheckRun {
  id          String    @id @default(uuid()) @db.Uuid
  /// queued (waiting for the worker) | running | done | failed
  status      String    @default("queued")
  trigger     String    @default("schedule")
  requestedBy String?   @db.Uuid
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  summary     Json?

  findings RecheckFinding[]
}

model RecheckFinding {
  id            String        @id @default(uuid()) @db.Uuid
  runId         String        @db.Uuid
  sourceId      String        @db.Uuid
  kind          FindingKind
  oldHash       String?
  newHash       String?
  diffSnippet   String?
  prevCheckedAt DateTime?
  httpStatus    Int?
  finalUrl      String?
  note          String?
  status        FindingStatus @default(open)
  reviewedBy    String?       @db.Uuid
  reviewedAt    DateTime?

  run    RecheckRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  source Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ---------------------------------------------------------- operations

model AiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  task         String
  tier         String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsdEst   Decimal  @default(0) @db.Decimal(10, 5)
  status       String
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  diff       Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
