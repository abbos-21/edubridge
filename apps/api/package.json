{
  "name": "@edubridge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "typecheck": "prisma generate && tsc --noEmit -p .",
    "test": "prisma generate && vitest run",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:import": "tsx --env-file=../../.env scripts/import_catalog.ts",
    "snapshot": "tsx --env-file=../../.env scripts/export_snapshot.ts",
    "worker": "tsx --env-file=../../.env scripts/worker.ts",
    "role": "tsx --env-file=../../.env scripts/set_role.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@edubridge/shared": "*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/client": "^6.2.1",
    "fastify": "^5.2.0",
    "jose": "^5.10.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "autocannon": "^9.0.0",
    "dotenv-cli": "^11.1.0",
    "ical.js": "^2.1.0",
    "prisma": "^6.2.1"
  }
}
