{
  "name": "edubridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run db:migrate -w @edubridge/api",
    "db:import": "npm run db:import -w @edubridge/api",
    "dev:api": "npm run dev -w @edubridge/api"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "deepmerge-ts": "^8.0.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "deepmerge-ts": "$deepmerge-ts"
  }
}