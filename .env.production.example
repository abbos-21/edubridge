# Copy to .env.production ON THE SERVER and fill in. Never commit it. See docs/PRODUCTION.md.
SITE_ADDRESS=example.org
APP_ORIGIN=https://example.org

POSTGRES_PASSWORD=
SESSION_SECRET=
BACKUP_PASSPHRASE=
# Off-server backup copy (any S3-compatible storage). Leave empty to keep backups only on this server (not recommended).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# Sign-in
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.org/api/v1/auth/google/callback

# AI (the key lives only here)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_QUICK=claude-haiku-5-5
AI_MONTHLY_BUDGET_USD=50
AI_DAILY_REQUESTS_PER_USER=20

# Operations
METRICS_TOKEN=
RECHECK_ENABLED=true
RECHECK_INTERVAL_DAYS=30
LOG_LEVEL=info
# NODE_ENV is set to production by the compose file. These must stay off in production (the server refuses to start otherwise):
ALLOW_DEV_LOGIN=false
AI_MOCK=false
