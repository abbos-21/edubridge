# Copy to .env (never commit .env). Server-side only: nothing here may reach the web bundle.
NODE_ENV=development
PORT=8787
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://edubridge:edubridge@localhost:5433/edubridge?schema=public
DATABASE_URL_TEST=postgresql://edubridge:edubridge@localhost:5433/edubridge_test?schema=public

# Phase 2+ (mocked in tests; leave empty until you have real credentials)
SESSION_SECRET=
# Development only: sign in without Telegram/Google. The server refuses to start in production with this on.
ALLOW_DEV_LOGIN=true
COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MIN=200
SESSION_DAYS=30
TELEGRAM_BOT_USERNAME=
GOOGLE_REDIRECT_URI=
ANTHROPIC_API_KEY=
# Development only: canned replies instead of calling Anthropic (refused in production)
AI_MOCK=true
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_QUICK=
ANTHROPIC_MODEL_COMPLEX=
AI_MONTHLY_BUDGET_USD=50
AI_DAILY_REQUESTS_PER_USER=20
AI_BURST_PER_MIN=6
AI_TIMEOUT_MS=90000
ANTHROPIC_MODEL_COMPLEX=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reminders are never sent between these hours (Asia/Tashkent)
REMINDER_QUIET_START=22
REMINDER_QUIET_END=8
